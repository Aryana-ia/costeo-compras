# Copia este archivo como .streamlit/secrets.toml (en tu PC) o pega su contenido
# en Streamlit Cloud → App → Settings → Secrets.
# Es opcional: sin esto la app guarda solo en el disco del equipo donde corre.

[github]
token  = "github_pat_XXXXXXXXXXXXXXXXXXXX"   # token fine-grained: solo este repo, Contents = Read and write
repo   = "Aryana-ia/costeo-compras"
branch = "datos"                              # rama de datos (se crea sola). No uses "main".
